# Copy to .env and fill in the values.

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me

# Google Gemini API key (AI features, see AiService).
GEMINI_API_KEY=

# Optional (defaults shown)
# MONGO_URI=mongodb://localhost:27017/trincaunt
# PORT=3000

# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# Without them the app works but push notifications are disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (https URL or mailto:)
# VAPID_SUBJECT=https://trincaunt.ddns.net
