# Copy to .env and fill in the values.

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me

# Google Gemini API key (AI features, see AiService).
GEMINI_API_KEY=

# Optional: OpenRouter key, Qwen Omni fallback for photos and audio when Gemini fails.
OPENROUTER_API_KEY=

# Optional (defaults shown)
# MONGO_URI=mongodb://localhost:27017/trincaunt
# PORT=3000

# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
# Without them the app works but push notifications are disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (https URL or mailto:)
# VAPID_SUBJECT=https://trincaunt.ddns.net

# Password recovery. Public URL of the app for the links in the emails; in development
# it defaults to http://localhost:5173, in production no email is sent without it.
# APP_URL=https://trincaunt.ddns.net
# SMTP for those emails. Without SMTP_HOST, development prints the email to the log
# and production doesn't send it.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); false uses STARTTLS when the server offers it
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trincaunt <no-reply@example.com>"
# Reverse proxies whose X-Forwarded-For is trusted for the client IP used by the
# recovery limits. Defaults to loopback (a proxy on the same machine).
# TRUST_PROXY=loopback
