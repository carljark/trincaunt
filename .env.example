# Variables que lee docker-compose.yml. Copia a .env (en el mismo directorio que el compose).
# En producción este .env vive solo en el EC2 (~/trincaunt/.env): el despliegue no sube
# ningún .env local, así que se crea y edita directamente en el servidor.

# Obligatoria: docker compose falla si falta. Usa una cadena larga y aleatoria.
JWT_SECRET=

GEMINI_API_KEY=
